<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear any machine-wide feeds (private Telerik/DevExpress sources on this box return 401)
       so the build restores only from nuget.org and is reproducible on the evaluator's machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
